{
  "expo": {
    "name": "MosaicGuard",
    "slug": "mosaic-guard",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "mosaicguard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2",
      "bundleIdentifier": "com.maizhenying.mosaicguard"
    },
    "android": {
      "versionCode": 2,
      "package": "com.maizhenying.mosaicguard"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/mosaic-guard"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "MosaicGuard 需要访问相册以选择待打码的图片",
          "cameraPermission": "MosaicGuard 需要使用相机直接拍照打码"
        }
      ],
      "expo-asset",
      "expo-font",
      "./plugins/withFmtPatch"
    ]
  }
}
